# Copy to .env for local overrides, or set these as real environment
# variables in your deploy target (e.g. Vercel project settings).

# Required in production. Leave unset locally -- app/db.py will spin up a
# local embedded Postgres automatically (see requirements-dev.txt).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Flask's session/flash-cookie signing key. The default is fine for local
# dev; set a real random value in production.
# SECRET_KEY=change-me-to-a-long-random-value
